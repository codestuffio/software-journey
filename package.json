{
  "name": "software-journey",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": "11.7.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@software-journey/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm build && vitest run tests/*.test.ts && node --test tests/smoke.test.mjs",
    "test:e2e": "playwright test",
    "spec": "openspec",
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm spec:validate",
    "cli": "pnpm --filter @software-journey/cli dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@fission-ai/openspec": "1.13.1",
    "@playwright/test": "1.58.2",
    "turbo": "2.11.1",
    "typescript": "7.0.2",
    "vitest": "4.1.0"
  }
}
